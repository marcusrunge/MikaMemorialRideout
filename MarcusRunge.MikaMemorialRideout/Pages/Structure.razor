@page "/struktur"

<PageTitle>Struktur | Mika Memorial Rideout</PageTitle>

<main class="subpage subpage--muted">
    <div class="content-container">
        <header class="subpage__header">
            <p class="eyebrow">Gemeinsamer Ablauf</p>
            <h1>Struktur des Rideouts</h1>
            <p>Die Übersicht zeigt die geplante Reihenfolge, die einzelnen Segmente und die grundlegenden Regeln während der gemeinsamen Fahrt.</p>
        </header>

        <figure class="structure-figure">
            <a href="assets/rideout-structure.svg" target="_blank" rel="noopener noreferrer">
                <img src="assets/rideout-structure.svg"
                     alt="Struktur des Mika Memorial Rideouts mit Segmenten, Road Marshals, Polizei und Grundregeln" />
            </a>
            <figcaption>Tippe oder klicke auf die Grafik, um sie in voller Größe zu öffnen.</figcaption>
        </figure>
    </div>
</main>
