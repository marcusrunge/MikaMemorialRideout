@page "/"
@inject IRideoutApiClient ApiClient
@implements IDisposable

<PageTitle>Mika Memorial Rideout</PageTitle>

<main>
    <header class="event-hero">
        <div class="content-container event-hero__content event-hero__layout">
            <div class="event-hero__main">
                <p class="eyebrow">Danke, dass ihr mich mitgenommen habt!</p>
                <h1>Mika Memorial Rideout</h1>
                <p class="event-hero__introduction">
                    Gemeinsam fahren wir in Erinnerung an Mika. Hier findest du die wichtigsten Informationen
                    und kannst dich selbst oder eine Gruppe zum Rideout anmelden.
                </p>

                <section class="participant-summary" aria-labelledby="participant-summary-heading">
                    <div>
                        <span class="participant-summary__label" id="participant-summary-heading">Aktuell angemeldet</span>
                        <strong class="participant-summary__count">@_summary.PersonCount</strong>
                        <span class="participant-summary__unit">Personen</span>
                    </div>
                    <p>Summe aus Einzelanmeldungen und allen Personen in angemeldeten Gruppen.</p>
                </section>

                <div class="event-facts" aria-label="Veranstaltungsinformationen">
                    <article class="event-fact"><span>Datum</span><strong>Sonntag, 23. August 2026</strong></article>
                    <article class="event-fact"><span>Beginn</span><strong>13:00 Uhr</strong></article>
                    <article class="event-fact"><span>Treffpunkt</span><strong>Albrecht-Thaer-Gelände, Uelzen</strong></article>
                </div>

                @if (!string.IsNullOrWhiteSpace(_loadMessage))
                {
                    <p class="information-notice" role="status">@_loadMessage</p>
                }
            </div>

            <figure class="memorial-image">
                <img src="assets/mika-memorial.jpg"
                     alt="Beleuchtete Gedenkstelle für Mika mit Kerzen, Blumen und einem Schild mit der Aufschrift Mika Ride in Peace" />
                <figcaption>Ride in Peace</figcaption>
            </figure>
        </div>
    </header>

    <section class="page-section page-section--accent" id="anmeldung" aria-labelledby="registration-heading">
        <div class="content-container">
            <div class="section-heading">
                <p class="eyebrow">Teilnahme</p>
                <h2 id="registration-heading">Zum Rideout anmelden</h2>
                <p>Bitte wähle die passende Anmeldung. Entscheidend sind Herkunft und Personenanzahl.</p>
            </div>

            @if (!_registrationState.IsRegistrationOpen)
            {
                <aside class="registration-closed-notice" role="status"><strong>Die Anmeldung ist beendet</strong><p>Der Rideout hat stattgefunden. Die Formulare bleiben als Teil der Erinnerungsseite sichtbar, können aber nicht mehr ausgefüllt oder abgesendet werden.</p></aside>
            }
            <aside class="registration-respect-notice" aria-label="Hinweis zu ernst gemeinten Anmeldungen">
                <strong>Bitte nur ernst gemeinte Anmeldungen absenden.</strong>
                <p>Der Mika Memorial Rideout dient dem gemeinsamen Gedenken an Mika. Falsche, scherzhafte oder automatisierte Einträge sind pietätlos, erschweren die Organisation und werden entfernt.</p>
            </aside>

            <div class="registration-grid">
                <article class="registration-card registration-card--form">
                    <span class="card-category">Einzelanmeldung</span>
                    <h3>Ich melde mich selbst an</h3>
                    <IndividualRegistrationForm Disabled="@(!_registrationState.IsRegistrationOpen)" RegistrationCreated="ReloadSummaryAsync" />
                </article>

                <article class="registration-card registration-card--form">
                    <span class="card-category">Gruppenanmeldung</span>
                    <h3>Ich melde eine Gruppe an</h3>
                    <GroupRegistrationForm Disabled="@(!_registrationState.IsRegistrationOpen)" RegistrationCreated="ReloadSummaryAsync" />
                </article>
            </div>
        </div>
    </section>
</main>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private RegistrationStateResponse _registrationState = new(true, null);
    private PublicSummaryResponse _summary = new(0, 0, 0, 0);
    private string? _loadMessage;

    protected override async Task OnInitializedAsync() => await ReloadSummaryAsync();

    private async Task ReloadSummaryAsync()
    {
        try
        {
            var summaryTask = ApiClient.GetPublicSummaryAsync(_cancellationTokenSource.Token);
            var stateTask = ApiClient.GetRegistrationStateAsync(_cancellationTokenSource.Token);
            await Task.WhenAll(summaryTask, stateTask);
            _summary = await summaryTask;
            _registrationState = await stateTask;
            _loadMessage = null;
        }
        catch (Exception) when (!_cancellationTokenSource.IsCancellationRequested)
        {
            _loadMessage = "Der aktuelle Anmeldestand konnte gerade nicht geladen werden.";
        }
    }

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
