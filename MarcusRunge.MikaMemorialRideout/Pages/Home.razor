@page "/"
@inject IRideoutApiClient ApiClient
@implements IDisposable

<PageTitle>Mika Memorial Rideout</PageTitle>

<header class="event-hero">
    <div class="content-container event-hero__content">
        <p class="eyebrow">Danke, dass ihr mich mitgenommen habt!</p>
        <h1>Mika Memorial Rideout</h1>
        <p class="event-hero__introduction">
            Gemeinsam fahren wir in Erinnerung an Mika. Auf dieser Seite findest du den aktuellen
            Planungsstand, Informationen zur Route, Hinweise zum Ablauf und die Anmeldung zum Rideout.
        </p>

        <section class="participant-summary" aria-labelledby="participant-summary-heading">
            <div>
                <span class="participant-summary__label" id="participant-summary-heading">Aktuell angemeldet</span>
                <strong class="participant-summary__count">@_summary.PersonCount</strong>
                <span class="participant-summary__unit">Personen</span>
            </div>
            <p>Summe aus Einzelanmeldungen und allen Personen in angemeldeten Gruppen.</p>
        </section>

        <div class="event-facts" aria-label="Veranstaltungsinformationen">
            <article class="event-fact"><span>Datum</span><strong>Wird bekannt gegeben</strong></article>
            <article class="event-fact"><span>Beginn</span><strong>Wird bekannt gegeben</strong></article>
            <article class="event-fact"><span>Treffpunkt</span><strong>Wird bekannt gegeben</strong></article>
        </div>

        <a class="primary-button" href="#anmeldung">Zur Anmeldung</a>
    </div>
</header>

<main>
    <section class="page-section" id="planungsstand" aria-labelledby="planning-heading">
        <div class="content-container">
            <div class="section-heading">
                <p class="eyebrow">Aktuelle Lage</p>
                <h2 id="planning-heading">Stand der Rideout-Planung</h2>
                <p>Die einzelnen Punkte werden aktualisiert, sobald neue und belastbare Informationen vorliegen.</p>
            </div>

            @if (_overallStatus is not null)
            {
                <div class="@GetOverallStatusClass(_overallStatus.Level)">
                    <span class="@GetIndicatorClass(_overallStatus.Level)" aria-hidden="true"></span>
                    <div><span class="status-label">Gesamtstatus</span><strong>@_overallStatus.Summary</strong></div>
                </div>
            }

            <div class="status-grid">
                @foreach (var status in _planningStatuses.Where(item => item.Key != "overall"))
                {
                    <article class="@GetCardClass(status.Level)">
                        <div class="status-card__header">
                            <span class="@GetIndicatorClass(status.Level)" aria-hidden="true"></span>
                            <div>
                                <h3>@status.Title</h3>
                                <span class="status-text">@status.Summary</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(status.Details))
                        {
                            <p>@status.Details</p>
                        }
                    </article>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_loadMessage))
            {
                <p class="information-notice" role="status">@_loadMessage</p>
            }
            else
            {
                <p class="status-updated">Letzte Aktualisierung: @GetLastUpdatedText()</p>
            }
        </div>
    </section>

    <section class="page-section page-section--accent" id="anmeldung" aria-labelledby="registration-heading">
        <div class="content-container">
            <div class="section-heading">
                <p class="eyebrow">Teilnahme</p>
                <h2 id="registration-heading">Zum Rideout anmelden</h2>
                <p>Bitte wähle die passende Anmeldung. Entscheidend sind Herkunft und Personenanzahl.</p>
            </div>

            <div class="registration-grid">
                <article class="registration-card registration-card--form">
                    <span class="card-category">Einzelanmeldung</span>
                    <h3>Ich melde mich selbst an</h3>
                    <IndividualRegistrationForm RegistrationCreated="ReloadSummaryAsync" />
                </article>

                <article class="registration-card registration-card--form">
                    <span class="card-category">Gruppenanmeldung</span>
                    <h3>Ich melde eine Gruppe an</h3>
                    <GroupRegistrationForm RegistrationCreated="ReloadSummaryAsync" />
                </article>
            </div>
        </div>
    </section>

    <section class="page-section" id="route" aria-labelledby="route-heading">
        <div class="content-container">
            <div class="section-heading">
                <p class="eyebrow">Strecke</p>
                <h2 id="route-heading">Route des Rideouts</h2>
                <p>Die endgültige Strecke wird veröffentlicht, sobald die erforderlichen Abstimmungen abgeschlossen sind.</p>
            </div>
            <div class="route-placeholder">
                <div class="route-placeholder__symbol" aria-hidden="true">⌖</div>
                <div><h3>Routenkarte folgt</h3><p>Startpunkt, Strecke und wichtige Hinweise werden hier rechtzeitig vor dem Rideout angezeigt.</p></div>
            </div>
        </div>
    </section>

    <section class="page-section page-section--muted" id="struktur" aria-labelledby="structure-heading">
        <div class="content-container">
            <div class="section-heading">
                <p class="eyebrow">Gemeinsamer Ablauf</p>
                <h2 id="structure-heading">Struktur des Rideouts</h2>
                <p>Die Übersicht zeigt die geplante Reihenfolge, die einzelnen Segmente und die grundlegenden Regeln während der gemeinsamen Fahrt.</p>
            </div>
            <figure class="structure-figure">
                <a href="assets/rideout-structure.svg" target="_blank" rel="noopener noreferrer">
                    <img src="assets/rideout-structure.svg" alt="Struktur des Mika Memorial Rideouts mit Segmenten, Road Marshals, Polizei und Grundregeln" />
                </a>
                <figcaption>Tippe oder klicke auf die Grafik, um sie in voller Größe zu öffnen.</figcaption>
            </figure>
        </div>
    </section>
</main>

<footer class="page-footer">
    <div class="content-container page-footer__content">
        <div><strong>Mika Memorial Rideout</strong><p>Gemeinsam erinnern. Gemeinsam fahren.</p></div>
        <div class="page-footer__links"><span>Datenschutz folgt</span><span>Kontakt folgt</span></div>
    </div>
</footer>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private PublicSummaryResponse _summary = new(0, 0, 0, 0);
    private IReadOnlyList<PlanningStatusItemResponse> _planningStatuses = [];
    private PlanningStatusItemResponse? _overallStatus;
    private string? _loadMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var summaryTask = ApiClient.GetPublicSummaryAsync(_cancellationTokenSource.Token);
            var statusTask = ApiClient.GetPlanningStatusAsync(_cancellationTokenSource.Token);
            await Task.WhenAll(summaryTask, statusTask);

            _summary = await summaryTask;
            _planningStatuses = (await statusTask).Items;
            _overallStatus = _planningStatuses.FirstOrDefault(item => item.Key == "overall");
        }
        catch (Exception) when (!_cancellationTokenSource.IsCancellationRequested)
        {
            _loadMessage = "Der aktuelle Anmeldestand und die Statusinformationen konnten gerade nicht geladen werden.";
        }
    }

    private async Task ReloadSummaryAsync()
    {
        try
        {
            _summary = await ApiClient.GetPublicSummaryAsync(_cancellationTokenSource.Token);
        }
        catch (Exception) when (!_cancellationTokenSource.IsCancellationRequested)
        {
            _loadMessage = "Die Anmeldung wurde gespeichert, der aktuelle Gesamtstand konnte aber noch nicht neu geladen werden.";
        }
    }

    private string GetLastUpdatedText()
    {
        var lastUpdated = _planningStatuses.Where(item => item.UpdatedAtUtc.HasValue).MaxBy(item => item.UpdatedAtUtc)?.UpdatedAtUtc;
        return lastUpdated.HasValue ? lastUpdated.Value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm 'Uhr'") : "Noch nicht veröffentlicht";
    }

    private static string GetOverallStatusClass(PlanningStatusLevel level) => $"overall-status overall-status--{level.ToString().ToLowerInvariant()}";
    private static string GetCardClass(PlanningStatusLevel level) => $"status-card status-card--{level.ToString().ToLowerInvariant()}";
    private static string GetIndicatorClass(PlanningStatusLevel level) => $"status-indicator status-indicator--{level.ToString().ToLowerInvariant()}";

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
