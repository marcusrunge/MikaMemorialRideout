@page "/aktuelles"
@page "/status"
@inject IRideoutApiClient ApiClient
@implements IDisposable

<PageTitle>Aktuelles | Mika Memorial Rideout</PageTitle>

<main class="subpage">
    <div class="content-container">
        <header class="subpage__header">
            <p class="eyebrow">Aktuelle Lage</p>
            <h1>Stand der Rideout-Planung</h1>
            <p>Alle relevanten Abstimmungen und Vorbereitungen auf einen Blick.</p>
        </header>

        @if (_isLoading)
        {
            <p class="information-notice" role="status">Statusinformationen werden geladen.</p>
        }
        else if (!string.IsNullOrWhiteSpace(_loadMessage))
        {
            <p class="form-result form-result--error" role="alert">@_loadMessage</p>
        }
        else
        {
            @if (_overallStatus is not null)
            {
                <div class="@GetOverallStatusClass(_overallStatus.Level)">
                    <span class="@GetIndicatorClass(_overallStatus.Level)" aria-hidden="true"></span>
                    <div>
                        <span class="status-label">Gesamtstatus</span>
                        <strong>@_overallStatus.Summary</strong>
                        @if (!string.IsNullOrWhiteSpace(_overallStatus.Details))
                        {
                            <p>@_overallStatus.Details</p>
                        }
                    </div>
                </div>
            }

            <div class="status-grid">
                @foreach (var status in _planningStatuses.Where(item => item.Key != "overall"))
                {
                    <article class="@GetCardClass(status.Level)">
                        <div class="status-card__header">
                            <span class="@GetIndicatorClass(status.Level)" aria-hidden="true"></span>
                            <div>
                                <h3>@status.Title</h3>
                                <span class="status-text">@status.Summary</span>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(status.Details))
                        {
                            <p>@status.Details</p>
                        }
                    </article>
                }
            </div>

            <p class="status-updated">Letzte Aktualisierung: @GetLastUpdatedText()</p>
        }
    </div>
</main>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();
    private IReadOnlyList<PlanningStatusItemResponse> _planningStatuses = [];
    private PlanningStatusItemResponse? _overallStatus;
    private string? _loadMessage;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _planningStatuses = (await ApiClient.GetPlanningStatusAsync(_cancellationTokenSource.Token)).Items;
            _overallStatus = _planningStatuses.FirstOrDefault(item => item.Key == "overall");
        }
        catch (Exception) when (!_cancellationTokenSource.IsCancellationRequested)
        {
            _loadMessage = "Die Statusinformationen konnten gerade nicht geladen werden.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetLastUpdatedText()
    {
        var lastUpdated = _planningStatuses.Where(item => item.UpdatedAtUtc.HasValue).MaxBy(item => item.UpdatedAtUtc)?.UpdatedAtUtc;
        return lastUpdated.HasValue ? lastUpdated.Value.ToLocalTime().ToString("dd.MM.yyyy, HH:mm 'Uhr'") : "Noch nicht veröffentlicht";
    }

    private static string GetOverallStatusClass(PlanningStatusLevel level) => $"overall-status overall-status--{level.ToString().ToLowerInvariant()}";
    private static string GetCardClass(PlanningStatusLevel level) => $"status-card status-card--{level.ToString().ToLowerInvariant()}";
    private static string GetIndicatorClass(PlanningStatusLevel level) => $"status-indicator status-indicator--{level.ToString().ToLowerInvariant()}";

    public void Dispose()
    {
        _cancellationTokenSource.Cancel();
        _cancellationTokenSource.Dispose();
    }
}
