<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\Models\**" />
    <Content Remove="wwwroot\Models\**" />
    <EmbeddedResource Remove="wwwroot\Models\**" />
    <None Remove="wwwroot\Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\assets\mika-rideout-route.geojson"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Update="wwwroot\assets\mika-rideout-waypoints.geojson"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Update="wwwroot\assets\rideout-structure.svg"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
    <Content Update="wwwroot\staticwebapp.config.json"><CopyToOutputDirectory>Always</CopyToOutputDirectory></Content>
  </ItemGroup>

</Project>
