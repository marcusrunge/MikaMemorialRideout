@inject IRideoutApiClient ApiClient

<EditForm Model="_input" OnValidSubmit="SubmitAsync" class="registration-form">
    <DataAnnotationsValidator />
    <fieldset class="registration-form__fieldset" disabled="@Disabled">

    <div class="form-field">
        <label for="group-name">Gruppenname</label>
        <InputText id="group-name" @bind-Value="_input.GroupName" />
        <ValidationMessage For="() => _input.GroupName" />
    </div>

    <div class="form-field">
        <label for="group-contact">Ansprechperson</label>
        <InputText id="group-contact" @bind-Value="_input.Name" autocomplete="name" />
        <ValidationMessage For="() => _input.Name" />
    </div>

    <div class="form-field">
        <label for="group-email">E-Mail-Adresse</label>
        <InputText id="group-email" @bind-Value="_input.Email" autocomplete="email" inputmode="email" />
        <ValidationMessage For="() => _input.Email" />
    </div>

    <div class="form-row">
        <div class="form-field">
            <label for="group-origin">Herkunftsort oder Region</label>
            <InputText id="group-origin" @bind-Value="_input.Origin" />
            <ValidationMessage For="() => _input.Origin" />
        </div>

        <div class="form-field">
            <label for="group-count">Personenanzahl</label>
            <InputNumber id="group-count" @bind-Value="_input.PersonCount" min="1" max="500" />
            <ValidationMessage For="() => _input.PersonCount" />
        </div>
    </div>

    <div class="form-field">
        <label for="group-message">Nachricht <span>optional</span></label>
        <InputTextArea id="group-message" @bind-Value="_input.Message" rows="4" />
        <ValidationMessage For="() => _input.Message" />
    </div>

    <div class="honeypot" aria-hidden="true">
        <label for="group-website">Website</label>
        <InputText id="group-website" @bind-Value="_input.Website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-checkbox">
        <InputCheckbox id="group-privacy" @bind-Value="_input.PrivacyAccepted" />
        <label for="group-privacy">Ich habe die <a href="datenschutz" target="_blank">Datenschutzerklärung</a> gelesen und willige in die Verarbeitung der Angaben zur Organisation des Rideouts ein.</label>
    </div>
    <ValidationMessage For="() => _input.PrivacyAccepted" />

    <button class="secondary-button" type="submit" disabled="@_isSubmitting">
        @(_isSubmitting ? "Anmeldung wird gespeichert" : "Gruppe verbindlich anmelden")
    </button>

    </fieldset>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="@_messageClass" role="status">@_message</p>
    }
</EditForm>

@code {
    [Parameter] public bool Disabled { get; set; }
    [Parameter]
    public EventCallback RegistrationCreated { get; set; }

    private GroupRegistrationInput _input = new();
    private bool _isSubmitting;
    private string? _message;
    private string _messageClass = "form-result";

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _message = null;

        try
        {
            var request = new CreateRegistrationRequest
            {
                RegistrationType = "group",
                Name = _input.Name,
                GroupName = _input.GroupName,
                Email = _input.Email,
                Origin = _input.Origin,
                PersonCount = _input.PersonCount,
                Message = _input.Message,
                PrivacyAccepted = _input.PrivacyAccepted,
                Website = _input.Website
            };

            var result = await ApiClient.CreateRegistrationAsync(request, CancellationToken.None);
            _message = result.Message;
            _messageClass = result.Status == "created" ? "form-result form-result--success" : "form-result form-result--warning";

            if (result.Status == "created")
            {
                _input = new GroupRegistrationInput();
                await RegistrationCreated.InvokeAsync();
            }
        }
        catch (Exception)
        {
            _message = "Die Anmeldung konnte gerade nicht gespeichert werden. Bitte versuche es später erneut.";
            _messageClass = "form-result form-result--error";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
